\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gmap-codigo}[2026/11/14 v0.1 Ambientes de codigo e linha de comando do GMAp]

\RequirePackage{xcolor}
\RequirePackage{fancyvrb}
\RequirePackage{listings}

% Ambientes verbatim (fancyvrb)
\DefineVerbatimEnvironment{code}{Verbatim}
  {fontsize=\footnotesize,formatcom=\color{blue},frame=single,framesep=5mm}
\DefineVerbatimEnvironment{tabelaverb}{Verbatim}
  {fontsize=\footnotesize,frame=single,framesep=5mm}
\DefineVerbatimEnvironment{linhacomando}{Verbatim}
  {fontsize=\small,formatcom=\color{blue},numbers=left}
\DefineVerbatimEnvironment{comandos}{Verbatim}
  {fontsize=\small,formatcom=\color{blue}}

% Estilo de listings
\definecolor{gmapcodeverde}{rgb}{0,0.6,0}
\definecolor{gmapcodecinza}{rgb}{0.5,0.5,0.5}
\definecolor{gmapcoderoxo}{rgb}{0.58,0,0.82}
\lstdefinestyle{gmappython}{
  commentstyle=\color{gmapcodeverde},
  keywordstyle=\color{magenta},
  numberstyle=\tiny\color{gmapcodecinza},
  stringstyle=\color{gmapcoderoxo},
  basicstyle=\ttfamily\footnotesize,
  breaklines=true,
  keepspaces=true,
  numbers=left,
  numbersep=5pt,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  tabsize=2}

\endinput
